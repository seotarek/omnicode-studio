{
  "name": "omnicode/laravel-omnicode",
  "description": "Official Laravel Package for OmniCode Engine (Blade components, Facades, and Storage integration)",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "OmniCode Studio Engineering Team",
      "email": "engineering@omnicode.studio"
    }
  ],
  "repositories": [
    {
      "type": "path",
      "url": "../php",
      "options": {
        "versions": {
          "omnicode/omnicode-php": "1.0.0"
        }
      }
    }
  ],
  "require": {
    "php": "^8.1 || ^8.2 || ^8.3 || ^8.4 || ^8.5",
    "omnicode/omnicode-php": "^1.0 || *",
    "illuminate/support": "^10.0 || ^11.0",
    "illuminate/view": "^10.0 || ^11.0",
    "illuminate/filesystem": "^10.0 || ^11.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Omnicode\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Omnicode\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Omnicode\\Laravel\\OmniCodeServiceProvider"
      ],
      "aliases": {
        "OmniCode": "Omnicode\\Laravel\\Facades\\OmniCode"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
